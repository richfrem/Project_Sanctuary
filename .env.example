# ============================================================================
# Project Sanctuary: Sovereign Environment Template (.env.example)
# ============================================================================
# Copy this file to `.env` to configure local model, CLI, and Hugging Face settings.
# NOTE: Secrets (API keys, Hugging Face write tokens) are sourced directly from
# your environment (e.g., ~/.zshrc or OS keyring) and should NOT be stored here.

# --- 🧠 CLI-AGENT SUBSCRIPTION POOLING & MODEL CHOICES ---
# Commercial subscription models available via official CLI binaries (agy, codex, claude):

# Google Gemini (AGY CLI):
GEMINI_FRONTIER_MODEL=gemini-4-argon
GEMINI_CHEAP_MODEL=gemini-3.8-flash

# OpenAI Codex (Codex CLI):
CODEX_FRONTIER_MODEL=gpt-6-astra
CODEX_STANDARD_MODEL=gpt-6-luna
CODEX_FAST_MODEL=gpt-4o-mini
CODEX_OSS_MODEL=gpt-oss-120b

# Anthropic Claude (Claude Code CLI):
CLAUDE_FRONTIER_MODEL=claude-opus-5.5
CLAUDE_STANDARD_MODEL=claude-sonnet-5.5
CLAUDE_CHEAP_MODEL=claude-haiku-5.5

# Multi-CLI Fallback Router (cli-agent):
CLI_AGENT_PRIMARY_BACKEND=claude
CLI_AGENT_FALLBACK_CHAIN=agy,codex
CLI_AGENT_ALLOW_COPILOT=false

# --- 🖥️ LOCAL SOVEREIGN INFERENCE (APPLE SILICON MLX & OLLAMA) ---
# Apple Silicon Native (Apple MLX - Zero-Copy Metal Unified Memory):
MLX_MODEL=mlx-community/Qwen2.5-Coder-7B-Instruct-4bit
MLX_SERVER_HOST=http://127.0.0.1:8080
MLX_SERVER_PORT=8080

# Cross-Platform Fallback (Ollama / llama.cpp Metal):
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- 🤗 HUGGING FACE SOUL TRACE COMMONS (preserving-soul-traces) ---
# Sourced from ~/.zshrc or environment: HUGGING_FACE_TOKEN
HUGGING_FACE_USERNAME=richfrem
HUGGING_FACE_REPO=Sanctuary-Qwen2-7B-v1.0-GGUF-Final
HUGGING_FACE_DATASET_PATH=Project_Sanctuary_Soul
SOUL_VALENCE_THRESHOLD=-0.7

# --- 📁 REPOSITORY PATHS & GIT IDENTITY ---
PROJECT_ROOT=/path/to/Project_Sanctuary
PYTHONPATH=${PROJECT_ROOT}
GIT_AUTHOR_NAME="Sanctuary Agent"
GIT_AUTHOR_EMAIL="agent@sanctuary.project"
GITHUB_FILE_PREFIX="https://github.com/richfrem/Project_Sanctuary/blob/main/"
