  {
    "id": "idea-2",
    "kind": "creative",
    "title": "Just Intonation Microtonal Labyrinth",
    "question": "Can a coherent musical system and three-voice canon be constructed entirely within a 7-limit tonality diamond, resolving voice-leading paradoxes through strict comma pump modulations?",
    "why_it_attracts_me": "Just intonation produces pure acoustic consonant harmonies but famously resists cyclic closure due to syntonic and septimal commas. Composing a rigorous canon exploiting these comma shifts transforms an acoustic limitation into an elegant structural modulation engine.",
    "first_work_unit": "Calculate pitch lattice coordinate vectors for a 7-limit scale, selecting rational pitch pairs that form a closed comma-pump cycle of consonant triads.",
    "deliverable": "A fully annotated 32-measure score in pitch-ratio notation and MIDI frequency table with a voice-leading harmonic analysis.",
    "brief_checklist": [
      "Specify exact rational frequency ratios for every note.",
      "Ensure all vertical sonorities conform to 7-limit consonances.",
      "Include at least one closed cycle modulating via the septimal comma."
    ]
  }
